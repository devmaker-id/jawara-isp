[Unit]
Description=Jawara ISP — WhatsApp Gateway (Baileys worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/devmaker/jawara-isp
EnvironmentFile=/home/devmaker/jawara-isp/var/wa-worker.env
ExecStart=/home/devmaker/.hermes/tools/node-26.12.1-linux-x64/bin/node /home/devmaker/jawara-isp/wa-gateway/worker.js
Restart=always
RestartSec=5
StandardOutput=append:/home/devmaker/jawara-isp/var/wa-worker.log
StandardError=append:/home/devmaker/jawara-isp/var/wa-worker.log

[Install]
WantedBy=default.target
