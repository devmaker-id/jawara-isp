# Frontend tidak butuh variabel lingkungan.
# API dipanggil dengan baseURL relatif, lalu diteruskan oleh proxy /api di
# vite.config.ts ke http://localhost:7930.

# Jangan set VITE_API_BASE_URL ke URL backend — itu membuat path menjadi
# /api/api (double "/api").
# VITE_API_BASE_URL=http://localhost:7930/api