# ===== Koneksi database (wajib) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isp_billing
DB_PASSWORD=ganti-dengan-password-anda
DB_NAME=isp_billing

# ===== Keamanan (wajib — isi dua string acak yang panjang & berbeda) =====
JWT_SECRET=ganti-dengan-string-acak-panjang
SECRET_KEY=ganti-dengan-string-acak-lainnya

# ===== Port backend (opsional, default 7930) =====
PORT=7930

# ===== FreeRADIUS (opsional — bila kosong, memakai pengaturan dari database) =====
FREERADIUS_HOST=
FREERADIUS_SECRET=
FREERADIUS_NAS_ADDRESS=
# Alamat sumber paket CoA/Disconnect; wajib cocok dengan NAS yang didaftarkan.
RADIUS_COA_SOURCE=

# ===== WhatsApp Gateway (opsional — kosongkan WA_WORKER_TOKEN untuk menonaktifkan) =====
WA_WORKER_URL=http://127.0.0.1:3199
WA_WORKER_TOKEN=
WA_POLL_MS=
WA_AI_TIMEOUT_MS=

# ===== Integrasi lain (opsional) =====
HERMES_BIN=